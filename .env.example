PORT=5555
NODE_ENV=development
MONGO_URI=
# Local-only retry when Node cannot resolve MongoDB Atlas SRV/TXT records.
LOCAL_MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=
JWT_SECRET_FALLBACKS=
AUTH_COOKIE_NAME=glazia_auth
CORS_ORIGINS=https://glazia.in,https://www.glazia.in,https://quotation.glazia.in,http://localhost:3000,http://localhost:3001,https://hoppscotch.io

META_TOKEN=
META_NUMID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# One environment-managed super admin. Regular admins continue to use mobile OTP.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

MAIL_USER=
MAIL_PASS=

# Paysharp: server-only merchant credentials; never expose in frontend variables.
PAYSHARP_TOKEN=
# Common API root, WITHOUT /upi or /order/intent. Use the matching environment token.
# Sandbox: https://sandbox.paysharp.co.in/external/api/v1
PAYSHARP_BASE_URL=
# Optional compatibility fallback when PAYSHARP_BASE_URL is unset (includes /upi):
PAYSHARP_UPI_BASE_URL=
# Historical VA receipt reconciliation only; not needed for UPI checkout.
PAYSHARP_VA_BASE_URL=
QUOTATION_API_BASE_URL=https://quotation-api.glazia.in

# Controlled rollout: true = listed accounts only; false = all accounts.
# Comma-separated business-owner mobile numbers; member numbers do not qualify a business.
# Use these exact variable names in prod.env or hosting config, then restart backend-main.
Paysharp_test_active=true
Paysharp_Test_users=
